# Use the Supabase session pooler (port 5432), not direct or transaction pooler.
# Uploads turn on when DATABASE_URL and OPENAI_API_KEY are both set; without them only the samples work.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
OPENAI_API_KEY=sk-your-key-here
# Signs the session cookie that ties an upload to the browser that made it. Use a long random string
# (python -c "import secrets; print(secrets.token_hex(32))"). If unset, a random per-process secret is used and
# visitors lose their runs when the server restarts.
SESSION_SECRET=
STORAGE_DIR=./storage
# Optional: replay a run as of another day (YYYY-MM-DD), and the minimum each-occurrence limit for certificates.
# AS_OF=2026-10-22
# COI_MIN_EACH_OCCURRENCE=1000000
# Guardrails for public uploads (defaults shown).
# DAILY_LLM_BUDGET_USD=1.00
# RUN_COST_ESTIMATE_USD=0.02   # assumed cost of a queued or running run, counted against the budget
# MAX_UPLOAD_MB=10
# MAX_PAGES=20
# UPLOADS_PER_IP_PER_HOUR=5
# UPLOAD_TTL_HOURS=24
# CLEANUP_INTERVAL_MINUTES=60   # how often the background task deletes expired uploads
# Set to 1 to ignore this file entirely (tests and containers). Leave it commented in your own .env, or the
# database and key above are never read.
# PAPERBOUND_SKIP_DOTENV=1
